.geometry-viewer {
    flex-grow: 1;
}
.geometry-toolbar {
    flex-direction: row;
    flex-shrink: 0;
}
.geometry-caption {
    margin-left: 8px;
    margin-top: 5px;
    margin-bottom: 3px;
    white-space: normal;
    flex-shrink: 0;
}
.geometry-status {
    margin-left: 8px;
    margin-right: 8px;
    margin-bottom: 5px;
    white-space: normal;
    flex-shrink: 0;
}
.geometry-preview {
    flex-grow: 1;
    min-height: 200px;
}
